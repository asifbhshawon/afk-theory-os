# ==============================================================================
# AFK THEORY Business OS — Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Central PostgreSQL Database Connection
# Local development (host): postgresql://postgres:postgres@localhost:5432/afk_business_os
# Docker Compose network: postgresql://postgres:postgres@db:5432/afk_business_os
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/afk_business_os

# Authentication & Session Security (Set a strong 64+ char random string)
SESSION_SECRET=afk-theory-session-secret-local-production-key-must-be-min-64-characters-long-2026

# Storage Provider Configuration
# "local" = saves files to local disk under STORAGE_DIR (default for Docker / local dev)
# "supabase" = saves files to Supabase Storage bucket (required when hosting on Vercel)
STORAGE_PROVIDER=local
STORAGE_DIR=./storage
BACKUP_DIR=./backups

# Supabase Storage & Cloud Backup
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJh... (found in Supabase Dashboard -> Settings -> API -> Project API Keys)
# SUPABASE_STORAGE_BUCKET=evidence
# SUPABASE_BACKUP_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# DB_SSL=true

# Local Encrypted Backup Repository Key
RESTIC_PASSWORD=afk-theory-secure-local-backup-key-2026

# Currency & Business Identity
DEFAULT_CURRENCY=BDT
BUSINESS_NAME="AFK THEORY"
DEFAULT_TIMEZONE=Asia/Dhaka
